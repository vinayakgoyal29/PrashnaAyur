# Google Gemini API Key (Multimodal Live API & 2.0 Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Kiosk-to-Doctor Internal Dispatch Authentication Secret
INTERNAL_API_KEY=changeme-internal-token

# Doctor Server Base URL (for Kiosk server dispatch)
DOCTOR_SERVER_URL=http://127.0.0.1:8002

# SQLite Database File Path (defaults to hospital_ehr.db)
DB_PATH=hospital_ehr.db
